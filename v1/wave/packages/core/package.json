{
  "name": "@hotel-os/core",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-free money + ops core shared by Innora v1 (web/) and Hotel OS v2 (apps/api). Same GL path for both.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.110.9"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.110.9",
    "@types/node": "^22.13.10",
    "typescript": "^5.9.2"
  }
}
