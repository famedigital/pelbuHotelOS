# Hotel OS — copy to web/.env.local (never commit secrets)
# Multi-tenant white-label ERP. Point these at the hotelos Supabase project.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary = image CDN (+ Cursor MCP — docs/IMAGE_SERVER.md)
# Tenants override logos/photos via Settings; these are optional defaults.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=

RESEND_API_KEY=
# Verified sender after domain setup; until then Resend sandbox from works for tests
RESEND_FROM_EMAIL=Hotel OS <onboarding@resend.dev>
# Desk inbox for new booking / order alerts (per-property overrides in Settings)
NOTIFY_DESK_EMAIL=

# CallMeBot WhatsApp desk alerts (activate bot → paste key + intl phone)
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=

# Staff desk inbox PIN (/erp) — allowed in production only when ALLOW_DESK_PIN_IN_PROD=1
DESK_PIN=
# Set to 1 for launch day; remove after all desk staff use Auth + desk_role
ALLOW_DESK_PIN_IN_PROD=1

# Paid-tier polling budgets (optional). Legacy PELBU_PAID_TIER still accepted.
# HOTELOS_PAID_TIER=1
# NEXT_PUBLIC_HOTELOS_PAID_TIER=1

# Optional single-property flagship mapping (empty = resolve from Host / property switcher)
# FLAGSHIP_HOSTS=app.example.com,erp.example.com
# FLAGSHIP_PROPERTY_ID=
# FLAGSHIP_PROPERTY_SLUG=demo-hotel

# Observability (optional — no-op when unset)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Distributed rate limits (optional — in-memory fallback when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# POS void / comp manager override (falls back to DESK_PIN when unset)
POS_MANAGER_PIN=
# Nu threshold at/above which void requires manager PIN (default 500)
POS_VOID_MANAGER_THRESHOLD_BTN=500

# Staff portal (/staff) uses Supabase Auth with employee code + PIN.
# No extra env keys required beyond Supabase URL/anon/service role.

# Web Push (free VAPID keys). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Protects the cron routes (/api/cron/expire-holds, /api/staff/notifications/drain).
# Vercel Cron sends this automatically. Hobby only allows daily schedules, so the
# 5-15 min cadence comes from an external scheduler sending the same bearer header.
# Required in production for /api/cron/night-audit (fail-closed money path).
CRON_SECRET=

# App URL (no trailing slash). Used for metadata, QR codes, deposit links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional override when app host differs from SITE_URL
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fame Digital platform admins (comma-separated emails) for /admin
PLATFORM_ADMIN_EMAILS=you@famedigital.bt

# Playwright e2e (optional — see docs/VERIFICATION.md). Helpers fall back to DESK_PIN.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_DESK_PIN=
# PLAYWRIGHT_DESK_EMAIL=
# PLAYWRIGHT_DESK_PASSWORD=
# PLAYWRIGHT_MONEY_CYCLE=1
# PLAYWRIGHT_SKIP_WEBSERVER=1

# Search Console / Bing (optional — usually omit; platform is noindex)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics (optional; platform ERP is noindex by default)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Channex channel manager (optional until certification)
# Without these keys, desk can queue ARI locally but cannot flush/ack live.
CHANNEX_API_KEY=
CHANNEX_API_BASE=https://channex.io/api/v1
# Required for /api/channel/channex/webhook — requests 503 when unset
CHANNEX_WEBHOOK_SECRET=

# Payment gateway webhook (Pay.bt / bank QR). Desk mark-paid works without this.
# Endpoint /api/payments/webhook returns 503 until the secret is set.
PAYMENTS_WEBHOOK_SECRET=

# Finance import workbench (receipt PDF / bank statement extraction)
# Gemini key is server/worker only — never expose to the browser or store in DB/scripts
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Shared secret for services/finance-parser-worker claim/callback APIs
FINANCE_WORKER_SECRET=
